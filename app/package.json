{
  "name": "ganss-remap",
  "productName": "GANSS GM108 改键工具",
  "version": "0.1.2",
  "description": "GM108 可视化改键工具: 默认/禁用/改键 + 配置存档 + 安全下发",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/protocol.test.js test/review-issues.test.js test/main-modules.test.js",
    "dist": "electron-builder --win portable --publish never",
    "dist:mac": "electron-builder --mac dir --publish never",
    "dist:local": "electron-builder --win portable --config.win.signAndEditExecutable=false --publish never"
  },
  "build": {
    "appId": "com.ganss.gm108-remap",
    "productName": "GANSS GM108 Remap",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "GM108-Remap-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-hid@3.4.0": true
  }
}
